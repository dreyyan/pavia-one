// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "mysql" / "sqlite" depending on your DB
}

model Student {
  id        Int      @id @default(autoincrement())
  studentId String   @unique @db.VarChar(9)
  name      String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Adviser {
  id        Int      @id @default(autoincrement())
  adviserId String   @unique @db.VarChar(9)
  name      String
  email     String   @unique
  password  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}